@@ -8,13 +8,19 @@
  */
 #include "internal_sources.h"
 
+/* One-off freeze isolation: retain computation and DSP routing, but publish
+ * to owned RAM instead of the unverified physical generator exchange ports.
+ * This is not a generator-audio implementation. */
+volatile uint32_t mx1_internal_probe_samples[MX1_INTERNAL_PORT_COUNT]
+    __attribute__((section(".patch_data"))) = {0};
+
 void mx1_internal_audio_frame(void)
 {
     ((void (*)(void))0x01009841u)();
     /* Diagnostic programs use different shared-port layouts. */
     if (*(const volatile uint32_t *)0x6051deb8u <= 3u)
         mx1_internal_render(*(const volatile uint32_t *)0x20000b24u,
-                            (volatile uint32_t *)0x40101100u);
+                            mx1_internal_probe_samples);
     else
         mx1_internal_invalidate();
 }
